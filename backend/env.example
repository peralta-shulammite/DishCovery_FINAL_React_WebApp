 FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000
YOLO_API_URL=http://localhost:8000/detect

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_email_app_password_here

DB_HOST=your_database_host
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name
DB_SSL=true

JWT_SECRET=your_jwt_secret_here
PORT=5000
NODE_ENV=development

# Gemini API Configuration (Google Cloud Console)
# IMPORTANT: Get API key from Google Cloud Console, NOT Google AI Studio
# See backend/GEMINI_SETUP.md for detailed instructions
GEMINI_API_KEY=your_cloud_console_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CONF_THRESHOLD=0.7

